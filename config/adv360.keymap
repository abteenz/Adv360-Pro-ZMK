#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define KEYS_LEFT 0 1 2 3 4 5 6 \
                  14 15 16 17 18 19 20 \
                  28 29 30 31 32 33 34 \
                  46 47 48 49 50 51 \
                  60 61 62 63 64
#define KEYS_RIGHT 7 8 9 10 11 12 13 \
                   21 22 23 24 25 26 27 \
                   39 40 41 42 43 44 45 \
                   54 55 56 57 58 59 \
                   71 72 73 74 75
#define THUMBS_LEFT 35 36 52 65 66 67
#define THUMBS_RIGHT 37 38 53 68 69 70

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            // Trigger on right hand keys + right thumbs

            hold-trigger-key-positions = <KEYS_RIGHT THUMBS_RIGHT>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            // Trigger on left hand keys + left thumbs

            hold-trigger-key-positions = <KEYS_LEFT THUMBS_LEFT>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <270>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <0>;
        };

        tap_dance: tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        momonum: momonum {
            compatible = "zmk,behavior-hold-tap";
            label = "MOMONUM";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        mouse_clicks: mouse_clicks {
            compatible = "zmk,behavior-mouse-key-press";
            label = "MOUSE_CLICKS";
            #binding-cells = <1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        exclaim {
            bindings = <&kp EXCLAMATION>;
            key-positions = <17 18>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <16 17>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <44 29>;
        };

        dash {
            bindings = <&kp MINUS>;
            key-positions = <30 43>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <41 32>;
        };

        que {
            bindings = <&kp QUESTION>;
            key-positions = <40 33>;
        };

        semi {
            bindings = <&kp SEMI>;
            key-positions = <31 42>;
        };

        parant {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <22 23>;
        };

        rightparan {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <23 24>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL       &kp N1             &kp N2                &kp N3           &kp N4           &kp N5  &tog 1                                                                              &mo 3      &kp N6  &kp N7            &kp N8            &kp N9                &kp N0              &kp MINUS
&kp ESCAPE      &kp Q              &kp W                 &kp E            &kp R            &kp T   &none                                                                               &none      &kp Y   &kp U             &kp I             &kp O                 &kp SEMI            &kp BSLH
&kp TAB         &hml LEFT_SHIFT A  &hml LEFT_CONTROL S   &hml LEFT_ALT D  &hml LEFT_GUI F  &kp G   &none     &kp LEFT_CONTROL  &kp LALT              &kp RIGHT_CONTROL  &kp RIGHT_GUI  &none      &kp H   &hmr RIGHT_GUI J  &hmr RIGHT_ALT K  &hmr RIGHT_CONTROL L  &hmr RIGHT_SHIFT P  &kp SQT
&kp LEFT_SHIFT  &kp Z              &kp X                 &momonum 1 C     &kp V            &kp B                               &kp HOME              &kp PG_UP                                    &kp N   &kp M             &kp COMMA         &kp DOT               &kp FSLH            &kp RSHFT
&mo 4           &kp GRAVE          &kp LS(LEFT_COMMAND)  &kp LEFT         &kp RIGHT                &kp BSPC  &kp TAB           &kp LEFT_COMMAND      &kp PG_DN          &kp ENTER      &kp SPACE          &kp UP            &kp DOWN          &kp LBKT              &kp RBKT            &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                              &trans              &trans  &trans          &trans          &trans           &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                              &trans              &trans  &kp SPACE       &kp UP_ARROW    &kp V            &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans      &trans  &trans              &trans              &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                              &trans      &trans                                          &kp N   &kp M           &kp COMMA       &kp PERIOD       &kp SLASH  &trans
&trans  &trans  &trans  &trans  &trans          &mouse_clicks LCLK  &trans  &trans      &trans  &mouse_clicks MCLK  &mouse_clicks RCLK          &trans          &trans          &trans           &trans     &trans
            >;
        };
    };
};
